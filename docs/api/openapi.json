    "/api/v1/runs/{id}/events": {
      "get": {
        "tags": [
          "run-stream"
        ],
        "summary": "Replay committed run events in sequence order",
        "description": "SSE id is runId:seq. Last-Event-ID takes precedence over afterSeq. Disconnecting leaves the run active.",
        "operationId": "events",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Last-Event-ID",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "afterSeq",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/StreamingResponseBody"
                }
              }
            }
          }
        }
      }
    },
