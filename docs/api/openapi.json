    "/api/v1/ag-ui/runs": {
      "post": {
        "tags": [
          "agui-api"
        ],
        "summary": "Execute or replay a durable AG-UI interaction",
        "description": "Submit text, resume an interrupt, or use a Harness extension (harness.snapshot, harness.observe, harness.cancel, harness.recover). Repeating the original input replays the complete interaction.",
        "operationId": "run",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AguiInput"
              },
              "examples": {
                "Read thread": {
                  "description": "Read thread",
                  "value": {
                    "threadId": "11111111-1111-4111-8111-111111111111",
                    "runId": "read-1",
                    "messages": [],
                    "forwardedProps": {
                      "harness.snapshot": {}
                    }
                  }
                },
                "Observe task": {
                  "description": "Observe task",
                  "value": {
                    "threadId": "11111111-1111-4111-8111-111111111111",
                    "runId": "observe-1",
                    "messages": [],
                    "forwardedProps": {
                      "harness.observe": "33333333-3333-4333-8333-333333333333"
                    }
                  }
                },
                "Text turn": {
                  "description": "Text turn",
                  "value": {
                    "threadId": "11111111-1111-4111-8111-111111111111",
                    "runId": "turn-1",
                    "messages": [
                      {
                        "id": "input-1",
                        "role": "user",
                        "content": "整理发布步骤"
                      }
                    ]
                  }
                },
                "Approve publication": {
                  "description": "Approve publication",
                  "value": {
                    "threadId": "11111111-1111-4111-8111-111111111111",
                    "runId": "decision-1",
                    "messages": [],
                    "resume": [
                      {
                        "interruptId": "22222222-2222-4222-8222-222222222222",
                        "status": "resolved",
                        "payload": {
                          "approved": true,
                          "argsHash": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
                        }
                      }
                    ]
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "AG-UI events through the first interrupt or terminal outcome",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or unsupported input",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Membership or approval permission required",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Conversation unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Conflicting idempotent submission",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Admission quota exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
