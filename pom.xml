<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-parent</artifactId><version>4.1.3</version><relativePath/></parent>
  <groupId>io.superharness</groupId><artifactId>super-harness</artifactId><version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <properties>
    <java.version>21</java.version><agentscope.version>2.0.5</agentscope.version>
    <jackson-2-bom.version>2.21.8</jackson-2-bom.version><testcontainers.version>1.21.4</testcontainers.version>
    <netty.version>4.2.21.Final</netty.version>
    <opentelemetry.version>1.68.0</opentelemetry.version>
    <tomcat.version>11.0.29</tomcat.version>
    <log4j2.version>2.26.1</log4j2.version>
    <commons-lang3.version>3.18.0</commons-lang3.version>
    <postgresql.version>42.7.12</postgresql.version>
    <jedis.version>7.4.1</jedis.version>
    <mysql.version>9.2.0</mysql.version>
  </properties>
  <build><pluginManagement><plugins>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId>
      <configuration><forceCreation>true</forceCreation></configuration></plugin>
  </plugins></pluginManagement></build>
  <modules>
    <module>modules/sh-domain</module>
    <module>modules/sh-contract</module>
    <module>modules/sh-runtime-spi</module>
    <module>modules/sh-runtime-agentscope</module>
    <module>modules/sh-persistence</module>
    <module>modules/sh-run-engine</module>
    <module>apps/sh-api</module>
    <module>apps/sh-worker</module>
    <module>apps/sh-reconciler</module>
  </modules>
  <dependencyManagement><dependencies>
    <dependency><groupId>io.opentelemetry</groupId><artifactId>opentelemetry-api-incubator</artifactId><version>1.68.0-alpha</version></dependency>
    <dependency><groupId>org.testcontainers</groupId><artifactId>testcontainers-bom</artifactId><version>1.21.4</version><type>pom</type><scope>import</scope></dependency>
    <dependency><groupId>org.bouncycastle</groupId><artifactId>bcprov-jdk18on</artifactId><version>1.87</version></dependency>
    <dependency><groupId>org.json</groupId><artifactId>json</artifactId><version>20260719</version></dependency>
    <dependency><groupId>io.modelcontextprotocol.sdk</groupId><artifactId>mcp</artifactId><version>1.1.1</version></dependency>
    <dependency><groupId>io.superharness</groupId><artifactId>sh-domain</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>io.superharness</groupId><artifactId>sh-contract</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>io.superharness</groupId><artifactId>sh-runtime-spi</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>io.superharness</groupId><artifactId>sh-runtime-agentscope</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>io.superharness</groupId><artifactId>sh-persistence</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>io.superharness</groupId><artifactId>sh-run-engine</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>io.superharness</groupId><artifactId>sh-api</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>io.superharness</groupId><artifactId>sh-worker</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>io.superharness</groupId><artifactId>sh-reconciler</artifactId><version>${project.version}</version></dependency>
  </dependencies></dependencyManagement>
</project>
